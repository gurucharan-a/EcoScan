# Copy to .env — EcoScan local dev. NEVER commit real secrets.
# Frontend (Vite): only VITE_* vars are exposed to the browser. No private keys here.
VITE_ECOSCAN_API_URL=""
VITE_ECOSCAN_MODE="demo"

# Backend (FastAPI): read from environment, not source.
# PowerShell: $env:DEVICE_TOKEN="..."; $env:ECOSCAN_DB=".../ecoscan.db"
DEVICE_TOKEN="dev-token-change-me"
ECOSCAN_DB="./backend/ecoscan.db"

# Production (Supabase Postgres for prisma/ecoscan.prisma)
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"
